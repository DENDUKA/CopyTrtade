@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace CopyTrading.BlazorUI.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <title>CopyTrading Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <div id="app">
        <component type="typeof(CopyTrading.BlazorUI.Shared.App)" render-mode="ServerPrerendered" />
    </div>

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Произошла непредвиденная ошибка.
        </environment>
        <environment include="Development">
            Произошла ошибка. См. консоль браузера для деталей.
        </environment>
        <a href="" class="reload">Перезагрузить</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
