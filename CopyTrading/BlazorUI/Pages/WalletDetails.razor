@page "/wallet/{WalletAddress}"
@using CopyTrading.Services
@using CopyTrading.Models.Values
@using CopyTrading.Models.Models
@using CopyTrading.Models.Models.Enums
@using CopyTrading.Models.Models.Enums.Order
@inject CurrentWalletPositionService CurrentWalletPositionService
@inject FillsOrderService FillsOrderService
@inject NavigationManager NavigationManager

<div class="mb-3">
    <button class="btn btn-secondary" @onclick="BackToList">
        ← Назад к списку кошельков
    </button>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h4>
            Кошелек:
            <a href="https://app.dextrabot.com/wallet-details/@WalletAddress"
               target="_blank"
               rel="noopener noreferrer"
               class="wallet-link">
                @WalletAddress
            </a>
        </h4>
    </div>
    <div class="card-body">
        @if (snapshot == null)
        {
            <p>Загрузка...</p>
        }
        else if (!snapshot.Positions.Any())
        {
            <div class="alert alert-info">
                <p>Нет открытых позиций</p>
            </div>
        }
        else
        {
            <h5>Позиции</h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Symbol</th>
                            <th>Direction</th>
                            <th>Quantity</th>
                            <th>Entry Price</th>
                            <th>Volume USD</th>
                            <th>Leverage</th>
                            <th>Margin Usage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var position in GetSortedPositions(snapshot.Positions))
                        {
                            <tr>
                                <td><strong>@position.Symbol</strong></td>
                                <td>
                                    <span class="badge @(position.Direction == Direction.Long ? "bg-success" : "bg-danger")">
                                        @position.Direction
                                    </span>
                                </td>
                                <td>@position.Quantity.ToString("F4")</td>
                                <td>$@position.AverageEntryPrice.ToString("F2")</td>
                                <td>$@position.VolumeUsd.ToString("F2")</td>
                                <td>@position.Leverage x</td>
                                <td>$@position.MarginUsage.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <h5>Статистика</h5>
                <div class="row">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">Всего позиций</h6>
                                <h3>@snapshot.Positions.Count</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">Long позиций</h6>
                                <h3 class="text-success">@snapshot.Positions.Count(p => p.Direction == Direction.Long)</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-subtitle mb-2 text-muted">Short позиций</h6>
                                <h3 class="text-danger">@snapshot.Positions.Count(p => p.Direction == Direction.Short)</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Открытые ордера *@
        @if (wallet != null)
        {
            var openOrders = FillsOrderService.GetOpenOrdersByWallet(wallet);
            if (openOrders.Length > 0)
            {
                <hr class="my-4" />
                <h5>Открытые ордера (@openOrders.Length)</h5>
                <div class="table-responsive mt-3">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Symbol</th>
                                <th>Direction</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Quantity</th>
                                <th>Filled</th>
                                <th>Price</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var orderFills in GetSortedOrders(openOrders))
                            {
                                var order = orderFills.OriginalOrder;
                                <tr>
                                    <td><code>@order.OrderId</code></td>
                                    <td><strong>@order.Symbol</strong></td>
                                    <td>
                                        <span class="badge @(order.Direction == Direction.Long ? "bg-success" : "bg-danger")">
                                            @order.Direction
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@order.SubType</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@order.Status</span>
                                    </td>
                                    <td>@order.Quantity.ToString("F4")</td>
                                    <td>
                                        @orderFills.FilledQuantity.ToString("F4")
                                        @if (orderFills.FilledQuantity > 0)
                                        {
                                            <small class="text-muted">(@((orderFills.FilledQuantity / order.Quantity * 100).ToString("F0"))%)</small>
                                        }
                                    </td>
                                    <td>$@order.Price.ToString("F2")</td>
                                    <td><small>@order.Time.ToString("HH:mm:ss")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public string WalletAddress { get; set; } = string.Empty;

    private Wallet? wallet;
    private WalletPositionsSnapshot? snapshot;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(WalletAddress))
        {
            wallet = new Wallet(WalletAddress);
            snapshot = await CurrentWalletPositionService.GetSnapshot(wallet);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(WalletAddress))
        {
            wallet = new Wallet(WalletAddress);
            snapshot = await CurrentWalletPositionService.GetSnapshot(wallet);
            StateHasChanged();
        }
    }

    private IEnumerable<Position> GetSortedPositions(IEnumerable<Position> positions)
    {
        return positions
            .OrderBy(p => p.Symbol)
            .ThenBy(p => p.Direction)
            .ThenBy(p => p.AverageEntryPrice);
    }

    private IEnumerable<OrderFills> GetSortedOrders(OrderFills[] orders)
    {
        return orders
            .OrderBy(o => o.OriginalOrder.Symbol)       // Сначала по Symbol (алфавитный порядок)
            .ThenBy(o => o.OriginalOrder.Direction)     // Затем по Direction (Long перед Short)
            .ThenBy(o => o.OriginalOrder.Price);        // Затем по Price (по возрастанию)
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("/current-wallet-positions");
    }
}

<style>
    .wallet-link {
        color: #0d6efd;
        text-decoration: none;
        transition: color 0.2s;
        font-family: monospace;
    }

    .wallet-link:hover {
        color: #0a58ca;
        text-decoration: underline;
    }

    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }
</style>
