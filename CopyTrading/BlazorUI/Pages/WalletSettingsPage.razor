@page "/wallet-settings"
@using CopyTrading.Models.Values
@inject CopyTradeVolumePerWalletService VolumeService
@inject ILogger<WalletSettingsPage> Logger

<PageTitle>Настройки Wallet</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>
                <i class="fas fa-wallet"></i> Настройки Wallet
            </h1>
            <p class="text-muted">Задайте объём копитрейда (USD) для каждого кошелька.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-plus"></i> Добавить/обновить кошелёк
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">@successMessage</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Адрес Wallet (0x...)</label>
                        <input class="form-control" @bind="newWallet" placeholder="0x..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Объём (USD)</label>
                        <input class="form-control" type="number" step="0.01" min="0" @bind-value="newVolumeUsd" @bind-value:event="oninput" />
                    </div>
                    <button class="btn btn-primary" @onclick="AddOrUpdate">
                        <i class="fas fa-save"></i> Сохранить
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <i class="fas fa-list"></i> Текущие настройки
                </div>
                <div class="card-body p-0">
                    @if (settings.Count == 0)
                    {
                        <div class="p-3 text-muted">Пока нет настроек.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:60%">Wallet</th>
                                        <th style="width:25%">USD</th>
                                        <th style="width:15%"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in settings)
                                    {
                                        <tr>
                                            <td class="align-middle"><code>@s.Wallet.Value</code></td>
                                            <td style="max-width: 180px;">
                                                <input class="form-control form-control-sm" type="number" step="0.01" min="0"
                                                       value="@rowEdits.GetValueOrDefault(s.Wallet, s.VolumeUsd)"
                                                       @oninput="(e => OnRowEditChange(s.Wallet, e))" />
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-primary" title="Сохранить" @onclick="(() => SaveRow(s.Wallet))">
                                                        <i class="fas fa-save"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" title="Удалить" @onclick="(() => DeleteRow(s.Wallet))">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CopyTradeWalletSettings> settings = new();
    private string? newWallet;
    private decimal? newVolumeUsd;
    private string? errorMessage;
    private string? successMessage;
    private Dictionary<Wallet, decimal> rowEdits = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await VolumeService.GetAll();
            settings = all.OrderBy(s => s.Wallet.Value).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки настроек Wallet");
            errorMessage = "Ошибка загрузки настроек";
        }
    }

    private void OnRowEditChange(Wallet wallet, ChangeEventArgs e)
    {
        if (decimal.TryParse(Convert.ToString(e.Value), out var v) && v >= 0)
        {
            rowEdits[wallet] = v;
        }
    }

    private void ResetMessages()
    {
        errorMessage = null;
        successMessage = null;
    }

    private async Task AddOrUpdate()
    {
        ResetMessages();
        try
        {
            if (string.IsNullOrWhiteSpace(newWallet) || !Wallet.IsValid(newWallet))
            {
                errorMessage = "Некорректный адрес Wallet (ожидается 0x... из 42 символов).";
                return;
            }
            if (newVolumeUsd is null || newVolumeUsd < 0)
            {
                errorMessage = "Задайте неотрицательный объём USD.";
                return;
            }

            var wallet = new Wallet(newWallet);
            var updated = await VolumeService.CreateOrUpdate(wallet, newVolumeUsd.Value);

            var existing = settings.FirstOrDefault(x => x.Wallet.Equals(wallet));
            if (existing is null)
                settings.Add(updated);
            else
                existing.VolumeUsd = updated.VolumeUsd;

            settings = settings.OrderBy(s => s.Wallet.Value).ToList();
            successMessage = "Сохранено";
            newVolumeUsd = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка сохранения настройки Wallet");
            errorMessage = ex.Message;
        }
    }

    private async Task SaveRow(Wallet wallet)
    {
        ResetMessages();
        try
        {
            if (!rowEdits.TryGetValue(wallet, out var v) || v < 0)
            {
                errorMessage = "Введите корректное значение USD.";
                return;
            }

            var updated = await VolumeService.CreateOrUpdate(wallet, v);
            var existing = settings.First(x => x.Wallet.Equals(wallet));
            existing.VolumeUsd = updated.VolumeUsd;
            successMessage = "Обновлено";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка обновления строки Wallet");
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteRow(Wallet wallet)
    {
        ResetMessages();
        try
        {
            var ok = await VolumeService.Delete(wallet);
            if (ok)
            {
                settings.RemoveAll(x => x.Wallet.Equals(wallet));
                rowEdits.Remove(wallet);
                successMessage = "Удалено";
            }
            else
            {
                errorMessage = "Не удалось удалить запись";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка удаления Wallet");
            errorMessage = ex.Message;
        }
    }
}
