@page "/wallet-settings"
@using CopyTrading.Models.Values
@inject CopyTradeVolumePerWalletService VolumeService
@inject ILogger<WalletSettingsPage> Logger

<PageTitle>Настройки Wallet</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>
                <i class="fas fa-wallet"></i> Настройки Wallet
            </h1>
            <p class="text-muted">Задайте объём копитрейда (USD) для каждого кошелька.</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-plus"></i> Добавить/обновить кошелёк
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">@successMessage</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Адрес Wallet (0x...)</label>
                        <input class="form-control" @bind="newWallet" placeholder="0x..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Объём (USD)</label>
                        <input class="form-control" type="text" inputmode="decimal" @bind-value="newVolumeUsdText" @bind-value:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Коэффициент копирования (CopyKoef)</label>
                        <input class="form-control" type="text" inputmode="decimal" @bind-value="newCopyKoefText" @bind-value:event="oninput" />
                    </div>
                    <button class="btn btn-primary" @onclick="AddOrUpdate">
                        <i class="fas fa-save"></i> Сохранить
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <i class="fas fa-list"></i> Текущие настройки
                </div>
                <div class="card-body p-0">
                    @if (settings.Count == 0)
                    {
                        <div class="p-3 text-muted">Пока нет настроек.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:60%">Wallet</th>
                                        <th style="width:20%">USD</th>
                                        <th style="width:20%">CopyKoef</th>
                                        <th style="width:15%"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in settings)
                                    {
                                        <tr>
                                            <td class="align-middle"><code>@s.Wallet.Value</code></td>
                                            <td style="max-width: 160px;">
                                                <input class="form-control form-control-sm" type="text" inputmode="decimal"
                                                       value="@GetUsdText(s.Wallet, s.VolumeUsd)"
                                                       @oninput="(e => OnRowUsdEditChange(s.Wallet, e))" />
                                            </td>
                                            <td style="max-width: 160px;">
                                                <input class="form-control form-control-sm" type="text" inputmode="decimal"
                                                       value="@GetKoefText(s.Wallet, s.CopyKoef)"
                                                       @oninput="(e => OnRowKoefEditChange(s.Wallet, e))" />
                                            </td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-primary" title="Сохранить" @onclick="(() => SaveRow(s.Wallet))">
                                                        <i class="fas fa-save"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" title="Удалить" @onclick="(() => DeleteRow(s.Wallet))">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CopyTradeWalletSettings> settings = new();
    private string? newWallet;
    private string? newVolumeUsdText;
    private string? newCopyKoefText = "1";
    private string? errorMessage;
    private string? successMessage;
    private Dictionary<Wallet, decimal> rowUsdEdits = new();
    private Dictionary<Wallet, decimal> rowKoefEdits = new();
    private Dictionary<Wallet, string> rowUsdTextEdits = new();
    private Dictionary<Wallet, string> rowKoefTextEdits = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await VolumeService.GetAll();
            settings = all.OrderBy(s => s.Wallet.Value).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки настроек Wallet");
            errorMessage = "Ошибка загрузки настроек";
        }
    }

    private void OnRowUsdEditChange(Wallet wallet, ChangeEventArgs e)
    {
        var text = Convert.ToString(e.Value) ?? string.Empty;
        rowUsdTextEdits[wallet] = text;
        if (TryParseDecimalFlexible(text, out var v) && v >= 0)
        {
            rowUsdEdits[wallet] = v;
        }
    }

    private void OnRowKoefEditChange(Wallet wallet, ChangeEventArgs e)
    {
        var text = Convert.ToString(e.Value) ?? string.Empty;
        rowKoefTextEdits[wallet] = text;
        if (TryParseDecimalFlexible(text, out var v) && v > 0)
        {
            rowKoefEdits[wallet] = v;
        }
    }

    private void ResetMessages()
    {
        errorMessage = null;
        successMessage = null;
    }

    private static bool TryParseDecimalFlexible(object? value, out decimal result)
    {
        result = 0m;
        var s = Convert.ToString(value)?.Trim();
        if (string.IsNullOrEmpty(s)) return false;

        // Унификация: разрешаем и «.» и «,» и промежуточные состояния ("1.", "1,")
        var normalized = s.Replace(',', '.');
        if (normalized.EndsWith(".") && normalized.Count(c => c == '.') == 1)
        {
            // Промежуточное состояние — пока не парсим, считаем, что пользователь ещё вводит
            return false;
        }
        if (decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out result))
            return true;
        // Попытка по текущей культуре
        if (decimal.TryParse(s, NumberStyles.Number, CultureInfo.CurrentCulture, out result))
            return true;
        // Попытка по ru-RU
        if (decimal.TryParse(s, NumberStyles.Number, new CultureInfo("ru-RU"), out result))
            return true;
        return false;
    }

    private string GetUsdText(Wallet wallet, decimal current)
        => rowUsdTextEdits.TryGetValue(wallet, out var t) ? t : current.ToString(CultureInfo.InvariantCulture);

    private string GetKoefText(Wallet wallet, decimal current)
        => rowKoefTextEdits.TryGetValue(wallet, out var t) ? t : current.ToString(CultureInfo.InvariantCulture);

    private async Task AddOrUpdate()
    {
        ResetMessages();
        try
        {
            if (string.IsNullOrWhiteSpace(newWallet) || !Wallet.IsValid(newWallet))
            {
                errorMessage = "Некорректный адрес Wallet (ожидается 0x... из 42 символов).";
                return;
            }

            if (!TryParseDecimalFlexible(newVolumeUsdText, out var usd) || usd < 0)
            {
                errorMessage = "Задайте неотрицательный объём USD.";
                return;
            }
            if (!TryParseDecimalFlexible(newCopyKoefText, out var koef) || koef <= 0)
            {
                errorMessage = "CopyKoef должен быть > 0.";
                return;
            }

            var wallet = new Wallet(newWallet);
            var updated = await VolumeService.CreateOrUpdate(new CopyTradeWalletSettings
            {
                Wallet = wallet,
                VolumeUsd = usd,
                CopyKoef = koef
            });

            var existing = settings.FirstOrDefault(x => x.Wallet.Equals(wallet));
            if (existing is null)
                settings.Add(updated);
            else
            {
                existing.VolumeUsd = updated.VolumeUsd;
                existing.CopyKoef = updated.CopyKoef;
            }

            settings = settings.OrderBy(s => s.Wallet.Value).ToList();
            successMessage = "Сохранено";
            newVolumeUsdText = null;
            newCopyKoefText = "1";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка сохранения настройки Wallet");
            errorMessage = ex.Message;
        }
    }

    private async Task SaveRow(Wallet wallet)
    {
        ResetMessages();
        try
        {
            // Берём текущее значение из списка, если пользователь не редактировал поле
            var existing = settings.First(x => x.Wallet.Equals(wallet));

            decimal usd;
            if (rowUsdTextEdits.TryGetValue(wallet, out var usdText))
            {
                if (!TryParseDecimalFlexible(usdText, out usd)) usd = existing.VolumeUsd;
            }
            else if (!rowUsdEdits.TryGetValue(wallet, out usd))
            {
                usd = existing.VolumeUsd;
            }
            if (usd < 0)
            {
                errorMessage = "Введите корректное значение USD.";
                return;
            }

            decimal koef;
            if (rowKoefTextEdits.TryGetValue(wallet, out var koefText))
            {
                if (!TryParseDecimalFlexible(koefText, out koef)) koef = existing.CopyKoef;
            }
            else if (!rowKoefEdits.TryGetValue(wallet, out koef))
            {
                koef = existing.CopyKoef;
            }
            if (koef <= 0)
            {
                errorMessage = "Введите корректный CopyKoef (> 0).";
                return;
            }

            var updated = await VolumeService.CreateOrUpdate(new CopyTradeWalletSettings
            {
                Wallet = wallet,
                VolumeUsd = usd,
                CopyKoef = koef
            });

            existing.VolumeUsd = updated.VolumeUsd;
            existing.CopyKoef = updated.CopyKoef;
            successMessage = "Обновлено";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка обновления строки Wallet");
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteRow(Wallet wallet)
    {
        ResetMessages();
        try
        {
            var ok = await VolumeService.Delete(new CopyTradeWalletSettings { Wallet = wallet });
            if (ok)
            {
                settings.RemoveAll(x => x.Wallet.Equals(wallet));
                rowUsdEdits.Remove(wallet);
                rowKoefEdits.Remove(wallet);
                successMessage = "Удалено";
            }
            else
            {
                errorMessage = "Не удалось удалить запись";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка удаления Wallet");
            errorMessage = ex.Message;
        }
    }
}
