@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject ILogger<Index> Logger
@implements IAsyncDisposable

<PageTitle>Dashboard - CopyTrading</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="RefreshData">
                <i class="fas fa-sync-alt"></i> Обновить
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-3">Загрузка метрик...</p>
        </div>
    }
    else
    {
        <!-- Основные метрики -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">
                                    <i class="fas fa-chart-line"></i> Позиции
                                </h6>
                                <h2 class="mt-2">@positionsCount</h2>
                                <small>Активных позиций</small>
                            </div>
                            <i class="fas fa-chart-line fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">
                                    <i class="fas fa-list-ul"></i> Ордера
                                </h6>
                                <h2 class="mt-2">@ordersCount</h2>
                                <small>Всего ордеров</small>
                            </div>
                            <i class="fas fa-list-ul fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">
                                    <i class="fas fa-check-circle"></i> Filled
                                </h6>
                                <h2 class="mt-2">@filledOrdersCount</h2>
                                <small>Исполненных ордеров</small>
                            </div>
                            <i class="fas fa-check-circle fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-warning mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">
                                    <i class="fas fa-clock"></i> Open
                                </h6>
                                <h2 class="mt-2">@openOrdersCount</h2>
                                <small>Открытых ордеров</small>
                            </div>
                            <i class="fas fa-clock fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Статус подключения -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card @GetConnectionStatusClass()">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <i class="@GetConnectionIcon()"></i>
                                <strong>SignalR:</strong> @connectionStatus
                            </div>
                            <small>Последнее обновление: @lastUpdateTime.ToString("HH:mm:ss")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Последние позиции -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <i class="fas fa-chart-line"></i> Последние позиции
                    </div>
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        @if (!recentPositions.Any())
                        {
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-info-circle"></i> Позиций нет
                            </div>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var position in recentPositions.Take(5))
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-1">
                                                <i class="@GetDirectionIcon(position.Direction)"></i>
                                                @position.Symbol
                                            </h6>
                                            <small>@position.Direction</small>
                                        </div>
                                        <p class="mb-1">
                                            <small>
                                                Мой: @position.MyQuantity.ToString("F4") |
                                                Ratio: @position.PositionRatio.ToString("F4")
                                            </small>
                                        </p>
                                        <small class="text-muted">@position.LastUpdate.ToString("HH:mm:ss dd.MM")</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <a href="/positions" class="btn btn-sm btn-primary">
                            Все позиции <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Последние ордера -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <i class="fas fa-list-ul"></i> Последние ордера
                    </div>
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        @if (!recentOrders.Any())
                        {
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-info-circle"></i> Ордеров нет
                            </div>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var order in recentOrders.Take(5))
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between">
                                            <h6 class="mb-1">
                                                <i class="@GetDirectionIcon(order.Direction)"></i>
                                                @order.Symbol
                                            </h6>
                                            <span class="badge @GetOrderStatusBadgeClass(order.Status)">
                                                @order.Status
                                            </span>
                                        </div>
                                        <p class="mb-1">
                                            <small>
                                                $@order.Price.ToString("F2") × @order.Quantity.ToString("F4") =
                                                $@order.VolumeUsd.ToString("F2")
                                            </small>
                                        </p>
                                        <small class="text-muted">@order.Time.ToString("HH:mm:ss dd.MM")</small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <a href="/orders" class="btn btn-sm btn-primary">
                            Все ордера <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private HubConnection? hubConnection;
    private bool isLoading = true;
    private string connectionStatus = "Disconnected";
    private DateTime lastUpdateTime = DateTime.Now;

    private int positionsCount = 0;
    private int ordersCount = 0;
    private int openOrdersCount = 0;
    private int filledOrdersCount = 0;

    private List<PositionMapping> recentPositions = new();
    private List<OriginalOrder> recentOrders = new();

    protected override async Task OnInitializedAsync()
    {
        await InitializeSignalR();
    }

    private async Task InitializeSignalR()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/copytradinghub"))
                .WithAutomaticReconnect()
                .Build();

            // Подписываемся на начальные позиции
            hubConnection.On<PositionMapping[]>("ReceiveInitialPositions", async (receivedPositions) =>
            {
                try
                {
                    recentPositions = receivedPositions.OrderByDescending(p => p.LastUpdate).ToList();
                    positionsCount = recentPositions.Count;
                    lastUpdateTime = DateTime.Now;
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Ошибка при обработке позиций");
                }
            });

            // Подписываемся на обновления позиций
            hubConnection.On("PositionsUpdated", async () =>
            {
                await RefreshPositions();
            });

            // Подписываемся на новые ордера
            hubConnection.On<OriginalOrder[]>("ReceiveOrders", async (receivedOrders) =>
            {
                try
                {
                    foreach (var order in receivedOrders)
                    {
                        var existingOrder = recentOrders.FirstOrDefault(o => o.OrderId == order.OrderId);
                        if (existingOrder != null)
                        {
                            var index = recentOrders.IndexOf(existingOrder);
                            recentOrders[index] = order;
                        }
                        else
                        {
                            recentOrders.Add(order);
                        }
                    }

                    recentOrders = recentOrders.OrderByDescending(o => o.Time).ToList();
                    UpdateOrdersMetrics();
                    lastUpdateTime = DateTime.Now;
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Ошибка при обработке ордеров");
                }
            });

            // Подписываемся на завершение ордеров
            hubConnection.On<OrderFills>("ReceiveOrderFinished", async (orderFills) =>
            {
                var order = recentOrders.FirstOrDefault(o => o.OrderId == orderFills.OriginalOrder.OrderId);
                if (order != null)
                {
                    var index = recentOrders.IndexOf(order);
                    recentOrders[index] = orderFills.OriginalOrder;
                    UpdateOrdersMetrics();
                    lastUpdateTime = DateTime.Now;
                    await InvokeAsync(StateHasChanged);
                }
            });

            // Обработчики переподключения
            hubConnection.Reconnecting += (error) =>
            {
                connectionStatus = "Reconnecting...";
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            hubConnection.Reconnected += (connectionId) =>
            {
                connectionStatus = "Connected";
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            hubConnection.Closed += (error) =>
            {
                connectionStatus = "Disconnected";
                Logger.LogError(error, "SignalR отключен");
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            // Подключаемся
            await hubConnection.StartAsync();
            connectionStatus = "Connected";

            isLoading = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при инициализации SignalR");
            connectionStatus = "Error";
            isLoading = false;
        }
    }

    private async Task RefreshPositions()
    {
        if (hubConnection?.State == HubConnectionState.Connected)
        {
            try
            {
                var positions = await hubConnection.InvokeAsync<PositionMapping[]>("GetAllPositions");
                recentPositions = positions.OrderByDescending(p => p.LastUpdate).ToList();
                positionsCount = recentPositions.Count;
                lastUpdateTime = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Ошибка при обновлении позиций");
            }
        }
    }

    private async Task RefreshData()
    {
        Logger.LogInformation("Обновление данных Dashboard");
        await RefreshPositions();
        lastUpdateTime = DateTime.Now;
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateOrdersMetrics()
    {
        ordersCount = recentOrders.Count;
        openOrdersCount = recentOrders.Count(o => o.Status == OrderStatus.Open);
        filledOrdersCount = recentOrders.Count(o => o.Status == OrderStatus.Filled);
    }

    private string GetConnectionStatusClass()
    {
        return connectionStatus switch
        {
            "Connected" => "border-success",
            "Reconnecting..." => "border-warning",
            "Disconnected" => "border-secondary",
            "Error" => "border-danger",
            _ => "border-secondary"
        };
    }

    private string GetConnectionIcon()
    {
        return connectionStatus switch
        {
            "Connected" => "fas fa-plug text-success",
            "Reconnecting..." => "fas fa-spinner fa-spin text-warning",
            "Disconnected" => "fas fa-plug-circle-xmark text-secondary",
            "Error" => "fas fa-exclamation-triangle text-danger",
            _ => "fas fa-question-circle text-secondary"
        };
    }

    private string GetDirectionIcon(Direction direction)
    {
        return direction == Direction.Long
            ? "fas fa-arrow-up text-success"
            : "fas fa-arrow-down text-danger";
    }

    private string GetOrderStatusBadgeClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Open => "bg-primary",
            OrderStatus.Filled => "bg-success",
            OrderStatus.Canceled => "bg-secondary",
            OrderStatus.Rejected => "bg-danger",
            OrderStatus.Triggered => "bg-warning text-dark",
            OrderStatus.MarginCanceled => "bg-dark",
            _ => "bg-secondary"
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
