@page "/current-wallet-positions"
@using CopyTrading.Services
@using CopyTrading.Models.Values
@using CopyTrading.Models.Models
@inject CurrentWalletPositionService CurrentWalletPositionService
@inject NavigationManager NavigationManager

<h3>Отслеживаемые позиции кошельков</h3>

@if (selectedWallet == null)
{
    <!-- Список всех кошельков -->
    <div class="wallets-list">
        @if (wallets == null || !wallets.Any())
        {
            <div class="alert alert-info">
                <p>Нет отслеживаемых кошельков</p>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var wallet in wallets)
                {
                    <div class="col-md-6 mb-3">
                        <div class="card wallet-card" @onclick="() => SelectWallet(wallet)" style="cursor: pointer;">
                            <div class="card-body">
                                <h5 class="card-title">@wallet.Value</h5>
                                <p class="card-text">
                                    <small class="text-muted">Открытых позиций: @GetPositionCount(wallet)</small>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <!-- Детали выбранного кошелька -->
    <div class="mb-3">
        <button class="btn btn-secondary" @onclick="BackToWalletsList">
            ← Назад к списку кошельков
        </button>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h4>
                Кошелек:
                <a href="https://app.dextrabot.com/wallet-details/@selectedWallet.Value"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="wallet-link">
                    @selectedWallet.Value
                </a>
            </h4>
        </div>
        <div class="card-body">
            @if (selectedSnapshot == null)
            {
                <p>Загрузка...</p>
            }
            else if (!selectedSnapshot.Positions.Any())
            {
                <div class="alert alert-info">
                    <p>Нет открытых позиций</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Symbol</th>
                                <th>Direction</th>
                                <th>Quantity</th>
                                <th>Entry Price</th>
                                <th>Volume USD</th>
                                <th>Leverage</th>
                                <th>Margin Usage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var position in selectedSnapshot.Positions)
                            {
                                <tr>
                                    <td><strong>@position.Symbol</strong></td>
                                    <td>
                                        <span class="badge @(position.Direction == Direction.Long ? "bg-success" : "bg-danger")">
                                            @position.Direction
                                        </span>
                                    </td>
                                    <td>@position.Quantity.ToString("F4")</td>
                                    <td>$@position.AverageEntryPrice.ToString("F2")</td>
                                    <td>$@position.VolumeUsd.ToString("F2")</td>
                                    <td>@position.Leverage x</td>
                                    <td>$@position.MarginUsage.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <h5>Статистика</h5>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-2 text-muted">Всего позиций</h6>
                                    <h3>@selectedSnapshot.Positions.Count</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-2 text-muted">Long позиций</h6>
                                    <h3 class="text-success">@selectedSnapshot.Positions.Count(p => p.Direction == Direction.Long)</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-2 text-muted">Short позиций</h6>
                                    <h3 class="text-danger">@selectedSnapshot.Positions.Count(p => p.Direction == Direction.Short)</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<Wallet> wallets = new();
    private Wallet? selectedWallet;
    private WalletPositionsSnapshot? selectedSnapshot;

    protected override void OnInitialized()
    {
        LoadWallets();
    }

    private void LoadWallets()
    {
        wallets = CurrentWalletPositionService.GetAllWallets().ToList();
    }

    private int GetPositionCount(Wallet wallet)
    {
        var snapshot = CurrentWalletPositionService.GetSnapshot(wallet).Result;
        return snapshot?.Positions?.Count ?? 0;
    }

    private async Task SelectWallet(Wallet wallet)
    {
        selectedWallet = wallet;
        selectedSnapshot = await CurrentWalletPositionService.GetSnapshot(wallet);
        StateHasChanged();
    }

    private void BackToWalletsList()
    {
        selectedWallet = null;
        selectedSnapshot = null;
        LoadWallets();
        StateHasChanged();
    }
}

<style>
    .wallet-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .wallet-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }

    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .wallet-link {
        color: #0d6efd;
        text-decoration: none;
        transition: color 0.2s;
    }

    .wallet-link:hover {
        color: #0a58ca;
        text-decoration: underline;
    }
</style>
