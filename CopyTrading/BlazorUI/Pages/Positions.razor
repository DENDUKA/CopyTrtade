@page "/positions"
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject ILogger<Positions> Logger
@implements IAsyncDisposable

<PageTitle>Позиции - CopyTrading</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>
                <i class="fas fa-chart-line"></i> Активные позиции
            </h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="RefreshPositions">
                <i class="fas fa-sync-alt"></i> Обновить
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-3">Загрузка позиций...</p>
        </div>
    }
    else if (positions == null || !positions.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            Нет активных позиций
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h6 class="card-title">Всего позиций</h6>
                        <h3>@positions.Count()</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <h6 class="card-title">Long позиции</h6>
                        <h3>@positions.Count(p => p.Direction == Direction.Long)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white">
                    <div class="card-body">
                        <h6 class="card-title">Short позиции</h6>
                        <h3>@positions.Count(p => p.Direction == Direction.Short)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card @GetConnectionStatusClass()">
                    <div class="card-body">
                        <h6 class="card-title">SignalR</h6>
                        <h5>
                            <i class="fas @GetConnectionIcon()"></i>
                            @connectionStatus
                        </h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <input type="text"
                   class="form-control"
                   placeholder="Поиск по символу или кошельку..."
                   @bind="searchFilter"
                   @bind:event="oninput" />
        </div>

        @foreach (var position in GetFilteredPositions())
        {
            <PositionCard Position="@position" />
        }
    }
</div>

@code {
    private HubConnection? hubConnection;
    private List<PositionMapping> positions = new();
    private bool isLoading = true;
    private string connectionStatus = "Disconnected";
    private string searchFilter = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await InitializeSignalR();
    }

    private async Task InitializeSignalR()
    {
        try
        {
            // Создаем подключение к SignalR Hub
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/copytradinghub"))
                .WithAutomaticReconnect()
                .Build();

            // Подписываемся на получение начальных позиций
            hubConnection.On<PositionMapping[]>("ReceiveInitialPositions", async (receivedPositions) =>
            {
                try
                {
                    Logger.LogInformation($"Получено {receivedPositions.Length} позиций от сервера");
                    positions = receivedPositions.ToList();
                    isLoading = false;
                    await InvokeAsync(StateHasChanged);
                    Logger.LogInformation($"Позиции успешно загружены и отображены");
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Ошибка при обработке начальных позиций");
                }
            });

            // Подписываемся на обновления позиций
            hubConnection.On("PositionsUpdated", async () =>
            {
                Logger.LogInformation("Получено уведомление об обновлении позиций");
                await RefreshPositions();
            });

            // Обработчики переподключения
            hubConnection.Reconnecting += (error) =>
            {
                connectionStatus = "Reconnecting...";
                Logger.LogWarning("SignalR переподключается...");
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            hubConnection.Reconnected += (connectionId) =>
            {
                connectionStatus = "Connected";
                Logger.LogInformation($"SignalR переподключен: {connectionId}");
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            hubConnection.Closed += (error) =>
            {
                connectionStatus = "Disconnected";
                Logger.LogError(error, "SignalR отключен");
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            // Подключаемся
            Logger.LogInformation("Начинаем подключение к SignalR Hub...");
            await hubConnection.StartAsync();
            connectionStatus = "Connected";
            Logger.LogInformation("SignalR подключен успешно");

            // Даем время на получение начальных данных
            await Task.Delay(100);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при инициализации SignalR");
            connectionStatus = "Error";
            isLoading = false;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshPositions()
    {
        if (hubConnection?.State == HubConnectionState.Connected)
        {
            try
            {
                var receivedPositions = await hubConnection.InvokeAsync<PositionMapping[]>("GetAllPositions");
                positions = receivedPositions.ToList();
                Logger.LogInformation($"Обновлено {positions.Count} позиций");
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Ошибка при обновлении позиций");
            }
        }
    }

    private IEnumerable<PositionMapping> GetFilteredPositions()
    {
        if (string.IsNullOrWhiteSpace(searchFilter))
            return positions;

        var filter = searchFilter.ToLower();
        return positions.Where(p =>
            p.Symbol.ToLower().Contains(filter) ||
            p.TraderWallet.ToString().ToLower().Contains(filter) ||
            p.MyWallet.ToString().ToLower().Contains(filter));
    }

    private string GetConnectionStatusClass()
    {
        return connectionStatus switch
        {
            "Connected" => "bg-success text-white",
            "Reconnecting..." => "bg-warning text-dark",
            "Disconnected" => "bg-secondary text-white",
            "Error" => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }

    private string GetConnectionIcon()
    {
        return connectionStatus switch
        {
            "Connected" => "fa-plug",
            "Reconnecting..." => "fa-spinner fa-spin",
            "Disconnected" => "fa-plug-circle-xmark",
            "Error" => "fa-exclamation-triangle",
            _ => "fa-question-circle"
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
