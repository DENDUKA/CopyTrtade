@using CopyTrading.Models.Models
@using CopyTrading.Models.Models.Enums

@* Компонент для отображения одной позиции *@

<div class="card @GetCardClass() mb-3">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-2">
                <h5 class="card-title mb-0">
                    <i class="@GetDirectionIcon()"></i>
                    @Position.Symbol
                </h5>
                <small class="text-muted">@Position.Direction</small>
            </div>

            <div class="col-md-2">
                <small class="text-muted">Трейдер</small>
                <div class="fw-bold">@Position.TraderWallet</div>
            </div>

            <div class="col-md-2">
                <small class="text-muted">Мой кошелек</small>
                <div class="fw-bold">@Position.MyWallet</div>
                <div>@Position.MyQuantity.ToString()</div>
            </div>

            <div class="col-md-2">
                <small class="text-muted">Коэффициент</small>
                <div class="fw-bold">@Position.PositionRatio.ToString()</div>
            </div>

            <div class="col-md-2">
                <small class="text-muted">Обновлено</small>
                <div>@Position.LastUpdate.ToString("HH:mm:ss")</div>
                <small class="text-muted">@Position.LastUpdate.ToString("dd.MM.yyyy")</small>
            </div>

            <div class="col-md-2 text-end">
                <button class="btn btn-sm btn-outline-info" @onclick="ShowDetails">
                    <i class="fas fa-info-circle"></i> Детали
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public PositionMapping Position { get; set; } = null!;

    private string GetCardClass()
    {
        return Position.Direction == Direction.Long
            ? "border-success"
            : "border-danger";
    }

    private string GetDirectionIcon()
    {
        return Position.Direction == Direction.Long
            ? "fas fa-arrow-up text-success"
            : "fas fa-arrow-down text-danger";
    }

    private void ShowDetails()
    {
        // TODO: Показать детали позиции (модальное окно или переход на другую страницу)
    }
}
