# =============================================================================
# CopyTrading — пример файла переменных окружения
#
# Скопируйте в .env и заполните значения:
#   cp .env.example .env
#
# .env файл НЕ коммитится в репозиторий (.gitignore)
# =============================================================================

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production
APP_PORT=15050

# --- PostgreSQL ---
POSTGRES_HOST=copytrading-postgres
POSTGRES_PORT=5432`r`nPOSTGRES_EXTERNAL_PORT=15432
POSTGRES_DB=copytrading
POSTGRES_USER=copytrading_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
REDIS_HOST=copytrading-redis
REDIS_PORT=6379`r`nREDIS_EXTERNAL_PORT=16379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=5000
REDIS_SYNC_TIMEOUT=5000

# --- InfluxDB ---
INFLUXDB_URL=http://copytrading-influxdb:8086
INFLUXDB_TOKEN=CHANGE_ME_INFLUX_TOKEN
INFLUXDB_ORG=CopyTrade
INFLUXDB_BUCKET=copytrading
INFLUXDB_BUCKET_ORDERS=copytrading
INFLUXDB_BUCKET_TRADES=copytrading
INFLUXDB_BUCKET_CANDLES=copytrading
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=CHANGE_ME_INFLUX_PASSWORD
INFLUXDB_PORT=8086`r`nINFLUXDB_EXTERNAL_PORT=18086

# --- HyperLiquid API (биржа) ---
# Получить на https://app.hyperliquid.xyz -> Settings -> API
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=

# --- Docker image / local CI ---
DOCKER_IMAGE_NAME=copytrading-app
IMAGE_TAG=latest
JENKINS_PORT=18080
JENKINS_AGENT_PORT=15000



