# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=copytrading
POSTGRES_USER=copytrading_user
POSTGRES_PASSWORD=copytrading_password

# Database Provider (SQLite or PostgreSQL)
DATABASE_PROVIDER=PostgreSQL

# PostgreSQL Connection String (alternative to separate parameters)
# If set, this will override the individual parameters above
# POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=copytrading;Username=copytrading_user;Password=copytrading_password
